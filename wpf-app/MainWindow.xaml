<Window x:Class="SmartPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartPrint.ViewModels"
        Title="SMART PRINT — للطباعة المتقدمة"
        Height="880" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ArabicFont}"
        Background="{StaticResource SurfaceBgBrush}"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver"
        Closing="OnWindowClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- الهيدر -->
            <RowDefinition Height="Auto"/>  <!-- شريط الترخيص -->
            <RowDefinition Height="Auto"/>  <!-- التبويبات -->
            <RowDefinition Height="*"/>     <!-- المحتوى -->
            <RowDefinition Height="Auto"/>  <!-- شريط الحالة -->
        </Grid.RowDefinitions>

        <!-- ======================= 1. الهيدر ======================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- الشعار -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#22FFFFFF"
                            BorderBrush="#44FFFFFF" BorderThickness="1">
                        <TextBlock Text="🖨" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMART PRINT" Foreground="White" FontSize="17" FontWeight="Black"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="للطباعة المتقدمة" Foreground="#99FFFFFF" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- حالة الطابعة -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="#1AFFFFFF" CornerRadius="20" Padding="14,7"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPrinter.IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Foreground="White" FontSize="11.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="لا توجد طابعة"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPrinter.IsOnline}" Value="True">
                                                <Setter Property="Text" Value="متصل ✓"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedPrinter}" Value="{x:Null}">
                                                <Setter Property="Text" Value="لا توجد طابعة"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- الإجراءات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث الأجهزة" Command="{Binding RefreshDevicesCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Background="#1AFFFFFF" Foreground="White" BorderBrush="#44FFFFFF"
                            Margin="0,0,6,0" ToolTip="إعادة البحث عن الطابعات والاسكانرات"/>
                    <Button Command="{Binding ContactDeveloperCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Background="#25D366" Foreground="White" BorderBrush="#25D366"
                            Content="تفعيل / تواصل" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= 2. شريط الترخيص ======================= -->
        <Border Grid.Row="1" Padding="16,7" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLicenseBannerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LicenseBannerText}" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="نسخ كود الجهاز" Command="{Binding CopyMachineCodeCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ======================= 3. التبويبات ======================= -->
        <Border Grid.Row="2" Background="{StaticResource HeaderGradient}" Padding="20,0,20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Content="طباعة" GroupName="Tabs" Style="{StaticResource TabToggle}"
                             IsChecked="{Binding IsPrintTabSelected}" Margin="0,0,10,0"/>
                <RadioButton Content="الاسكانر" GroupName="Tabs" Style="{StaticResource TabToggle}"
                             IsChecked="{Binding IsScannerTabSelected}"/>
            </StackPanel>
        </Border>

        <!-- ======================= 4. المحتوى ======================= -->
        <Grid Grid.Row="3" Margin="16,14,16,10">

            <!-- ============ تبويب الطباعة ============ -->
            <Grid Visibility="{Binding IsPrintTabSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- العمود الأيمن: الملفات -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ملفات الطباعة" Style="{StaticResource SectionTitle}"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding PrintJobsList}"
                                 SelectedItem="{Binding SelectedJob}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="7" Padding="9,7"
                                            Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" FontSize="11.5"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding DocumentType}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding PagesText}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding FileSizeFormatted}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4"
                                                    Padding="5,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="9"
                                                           Foreground="#166534" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- رسالة عندما تكون القائمة فارغة -->
                        <TextBlock Grid.Row="1" Text="لا توجد ملفات&#x0a;اسحب الملفات هنا أو اضغط إضافة"
                                   FontSize="11" Foreground="#94A3B8" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintJobsList.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ إضافة ملفات" Command="{Binding AddFilesCommand}"
                                        Style="{StaticResource PrimaryButton}" FontSize="11.5" Padding="8,8"/>
                                <Button Grid.Column="2" Content="مجلد" Command="{Binding AddFolderCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="8,8"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▲" ToolTip="أعلى"
                                        Command="{Binding MoveUpCommand}" Style="{StaticResource SecondaryButton}" Padding="4,6"/>
                                <Button Grid.Column="2" Content="▼" ToolTip="أسفل"
                                        Command="{Binding MoveDownCommand}" Style="{StaticResource SecondaryButton}" Padding="4,6"/>
                                <Button Grid.Column="4" Content="✕" ToolTip="حذف المحدد"
                                        Command="{Binding DeleteSelectedCommand}" Style="{StaticResource SecondaryButton}" Padding="4,6"/>
                                <Button Grid.Column="6" Content="مسح الكل"
                                        Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButton}" Padding="4,6" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- العمود الأوسط: المعاينة -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="معاينة حقيقية للمستند" Style="{StaticResource SectionTitle}"
                                       HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="−" Command="{Binding ZoomOutCommand}" Width="26"
                                        Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,3,8"/>
                                <Button Content="+" Command="{Binding ZoomInCommand}" Width="26"
                                        Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,3,8"/>
                                <Button Content="↻" Command="{Binding RotateCommand}" Width="26"
                                        Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,3,8"
                                        ToolTip="تدوير 90°"/>
                                <Button Content="⇄" Command="{Binding FlipDuplexCommand}" Width="26"
                                        Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,0,8"
                                        ToolTip="الوجه الآخر"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#E8EDF3" CornerRadius="8" Padding="10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding CurrentPreviewBitmap}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.LayoutTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}"/>
                                            <RotateTransform Angle="{Binding PreviewRotation}"/>
                                        </TransformGroup>
                                    </Image.LayoutTransform>
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPreviewBitmap}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CurrentSheetIndicator}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="السابق" Command="{Binding PrevPageCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" Margin="0,0,5,0"/>
                                <Button Content="التالي" Command="{Binding NextPageCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- العمود الأيسر: الإعدادات -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- الطابعة -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="الطابعة" Style="{StaticResource SectionTitle}"/>
                                <ComboBox ItemsSource="{Binding InstalledPrinters}"
                                          SelectedItem="{Binding SelectedPrinter}"
                                          DisplayMemberPath="DisplayName"/>
                                <TextBlock Text="{Binding SelectedPrinter.Status}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedPrinter.Model}" FontSize="9.5"
                                           Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- الورق -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="الورق والدرج" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="المقاس" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SelectedPrinter.SupportedSizes}"
                                          SelectedItem="{Binding SelectedPaperSize}"
                                          DisplayMemberPath="Name" Margin="0,0,0,8"/>
                                <TextBlock Text="الدرج" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SelectedPrinter.PaperTrays}"
                                          SelectedItem="{Binding SelectedTray}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>

                        <!-- خيارات الطباعة -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="خيارات الطباعة" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="اللون" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="ملون" IsChecked="{Binding IsColorMode}" Margin="0,0,14,0"
                                                 GroupName="Color"/>
                                    <RadioButton Content="رمادي / توفير" GroupName="Color"
                                                 IsChecked="{Binding IsGrayscaleMode}"/>
                                </StackPanel>

                                <TextBlock Text="الوجه/الظهر" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DuplexChoices}"
                                          SelectedValue="{Binding SelectedDuplexMode}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"
                                          Margin="0,0,0,8"/>

                                <TextBlock Text="التخطيط" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding LayoutChoices}"
                                          SelectedValue="{Binding SelectedLayout}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"
                                          Margin="0,0,0,8"/>

                                <TextBlock Text="عدد النسخ" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- الاختصارات -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="اختصارات سريعة" Style="{StaticResource SectionTitle}"/>
                                <Button Content="🌿 وضع التوفير" Command="{Binding ApplyEcoPresetCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,5"/>
                                <Button Content="📖 وضع الكتيب" Command="{Binding ApplyBookletPresetCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,5"/>
                                <Button Content="✨ جودة فائقة" Command="{Binding ApplyHighQualityPresetCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- الحبر -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="مستويات الحبر" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding SelectedPrinter.InkStatusText}" FontSize="9.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,7"/>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="أسود" FontSize="10.5"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding SelectedPrinter.InkLevels.Black}"
                                                 Maximum="100" Foreground="#1F2937"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedPrinter.InkLevels.Black, StringFormat={}{0}%}"
                                               FontSize="9.5" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="سماوي" FontSize="10.5"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding SelectedPrinter.InkLevels.Cyan}"
                                                 Maximum="100" Foreground="#0284C7"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedPrinter.InkLevels.Cyan, StringFormat={}{0}%}"
                                               FontSize="9.5" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="أرجواني" FontSize="10.5"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding SelectedPrinter.InkLevels.Magenta}"
                                                 Maximum="100" Foreground="#E11D48"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedPrinter.InkLevels.Magenta, StringFormat={}{0}%}"
                                               FontSize="9.5" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="أصفر" FontSize="10.5"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding SelectedPrinter.InkLevels.Yellow}"
                                                 Maximum="100" Foreground="#EAB308"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedPrinter.InkLevels.Yellow, StringFormat={}{0}%}"
                                               FontSize="9.5" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- زر الطباعة -->
                        <Button Content="🖨  طباعة" Command="{Binding StartPrintingCommand}"
                                Style="{StaticResource PrimaryButton}" FontSize="15" Padding="0,13" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PrintJobSummaryText}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ تبويب الاسكانر ============ -->
            <Grid Visibility="{Binding IsScannerTabSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- إعدادات المسح -->
                <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="الاسكانر" Style="{StaticResource SectionTitle}"/>
                                <ComboBox ItemsSource="{Binding InstalledScanners}"
                                          SelectedItem="{Binding SelectedScanner}"
                                          DisplayMemberPath="Name"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0">
                                    <Run Text="المصادر: "/>
                                    <Run Text="{Binding SelectedScanner.SourceText}"/>
                                </TextBlock>

                                <TextBlock Text="مصدر الورق" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding ScanSourceChoices}"
                                          SelectedValue="{Binding ScanSource}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"/>

                                <TextBlock Text="الدقة" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding SelectedDpi}"/>

                                <TextBlock Text="اللون" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding ScanColorChoices}"
                                          SelectedValue="{Binding ScanColorMode}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"/>

                                <TextBlock Text="عدد نسخ التصوير" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding CopyCopiesText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="إجراءات المسح" Style="{StaticResource SectionTitle}"/>
                                <Button Content="👁  معاينة سريعة" Command="{Binding QuickPreviewScanCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Padding="0,9"/>
                                <Button Content="📄  مسح إلى PDF (متعدد الصفحات)" Command="{Binding ScanToMultiPagePdfCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" FontSize="11.5" Padding="0,10"/>
                                <Button Content="🖼  مسح إلى صورة JPG" Command="{Binding ScanToJpgCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Padding="0,9"/>
                                <Button Content="📑  تصوير فوري (مسح + طباعة)" Command="{Binding InstantCopyCommand}"
                                        Style="{StaticResource PrimaryButton}" Background="#059669" Padding="0,11" FontSize="12"/>
                                <TextBlock Text="{Binding ScannedPagesSummary}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- المعاينة -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="المستند الممسوح" Style="{StaticResource SectionTitle}"/>

                        <Border Grid.Row="1" Background="#E8EDF3" CornerRadius="8" Padding="10">
                            <Grid>
                                <Image Source="{Binding CurrentScannedImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="لم يتم مسح أي صفحة بعد"
                                           Foreground="#94A3B8" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentScannedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ طبقة الانشغال ============ -->
            <Border Background="#B3000000" Panel.ZIndex="99">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="6" IsIndeterminate="True" Foreground="#1D9BF0"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,14,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

